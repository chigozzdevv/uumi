{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uumi.web.app/evidence/manifest.schema.json",
  "title": "Uumi evidence manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "organisation_id", "created_at", "artifacts"],
  "properties": {
    "run_id": { "type": "string", "minLength": 1 },
    "organisation_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "path", "sha256", "content_type", "source", "captured_at"],
        "properties": {
          "type": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "content_type": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 },
          "captured_at": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
