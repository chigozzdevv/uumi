# Only for running the real API process outside Cloud Run. The deployed demo
# receives these values from Terraform automatically.

UUMI_PROJECT_ID=replace-with-project-id
UUMI_REGION=us-east1
UUMI_OIDC_AUDIENCE=https://api.example.com
UUMI_CAPABILITY_SECRET=projects/replace-with-project-id/secrets/uumi-capability/versions/1
UUMI_BROWSER_GATEWAY_URL=https://browser.example.com
UUMI_WALKTHROUGH_BUCKET=replace-with-walkthrough-bucket
