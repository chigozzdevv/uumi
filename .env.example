# Only for running the real API process outside Cloud Run. The deployed demo
# receives these values from Terraform automatically.

FIREKEY_PROJECT_ID=replace-with-project-id
FIREKEY_REGION=us-east1
FIREKEY_OIDC_AUDIENCE=https://api.example.com
FIREKEY_CAPABILITY_SECRET=projects/replace-with-project-id/secrets/firekey-capability/versions/1
FIREKEY_BROWSER_GATEWAY_URL=https://browser.example.com
FIREKEY_WALKTHROUGH_BUCKET=replace-with-walkthrough-bucket
