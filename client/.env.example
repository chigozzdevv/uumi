# Real Python API used by the Vite development proxy.
UUMI_DEV_API_URL=http://127.0.0.1:8000

# Leave empty when the dashboard and API share an origin.
VITE_API_URL=

# Firebase web configuration. These values identify the public web app; they are
# not service-account credentials or Uumi secret material.
VITE_FIREBASE_API_KEY=replace-with-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=useuumi.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=useuumi
VITE_FIREBASE_APP_ID=replace-with-uumi-web-app-id
