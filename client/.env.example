# Local Python API used by the Vite development proxy. This is runtime
# configuration, not a credential.
UUMI_DEV_API_URL=http://127.0.0.1:8000

# Leave empty when the dashboard and API share an origin. Set an HTTPS origin
# only when developing the client against a separately hosted API.
VITE_API_URL=

# Public Firebase web-app identifiers. Firebase includes these values in every
# browser build; they do not authorise Google Cloud access and are not secrets.
VITE_FIREBASE_API_KEY=replace-with-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=useuumi.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=useuumi
VITE_FIREBASE_APP_ID=replace-with-uumi-web-app-id

# Never place Google OAuth client secrets, service-account credentials,
# capability keys, or provider credentials in this file. Production secret
# material belongs in Google Secret Manager.
